# ===========================================================================
# ADx Auto Forward Bot - environment template
#
#   cp .env.example .env        then fill in the REQUIRED values
#
# The bot loads .env on startup (python-dotenv) and docker compose reads the
# same file via env_file, so one file works for both. Variables that already
# exist in the environment always win over the file.
# Never commit .env - only this template belongs in git.
# ===========================================================================


# ===========================================================================
# REQUIRED
# ===========================================================================

# Telegram API credentials: https://my.telegram.org -> "API development tools"
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# Your Telegram user id (owner of the bot, can use /stats /broadcast /restart).
# Several owners: separate them with spaces -> BOT_OWNER_ID=111111111 222222222
BOT_OWNER_ID=

# MongoDB connection string: https://cloud.mongodb.com -> Connect -> Drivers
DATABASE_URI=


# ===========================================================================
# DATABASE
# ===========================================================================

# Database name inside the cluster (created on first write)
# DATABASE_NAME=Cluster0


# ===========================================================================
# BOT BEHAVIOUR
# ===========================================================================

# Session file name for the main bot
# BOT_SESSION=bot

# Image shown on the /start and /settings screens
# PICS=https://files.catbox.moe/uevfz8.jpg


# ===========================================================================
# LOGGING AND FORCE SUBSCRIBE
# Both are disabled while their channel is empty.
# ===========================================================================

# Channel id that receives #NewUser and #addbot logs, e.g. -1001234567890
# LOG_CHANNEL=

# Ask users to join a channel before they can use the bot
# FORCE_SUB_ON=True
# FORCE_SUB_CHANNEL=https://t.me/yourchannel


# ===========================================================================
# BRANDING
# Every label and link in the bot UI comes from these values.
# ===========================================================================

# BOT_NAME=ADx Auto Forward Bot
# BOT_USERNAME=ADxAutoForwardBot
# DEVELOPER_NAME=ADx
# UPDATES_CHANNEL=https://t.me/ADxUpdates
# SUPPORT_GROUP=https://t.me/ADxSupport
# REPO_URL=https://github.com/adgamerx/ADx-AutoForward-Bot
# BOT_VERSION=V-3.0.0


# ===========================================================================
# AUTO FORWARD TUNING
# ===========================================================================

# Seconds between checks of a source channel (minimum 10)
# AUTOFORWARD_INTERVAL=30

# Messages fetched per Telegram request (maximum 200)
# AUTOFORWARD_BATCH=100

# Backlog drained per check after downtime, so the target is never flooded
# AUTOFORWARD_MAX_PER_CYCLE=300
